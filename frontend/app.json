{
  "expo": {
    "name": "SkiTracker",
    "slug": "skitracker",
    "platforms": [
      "ios"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1220",
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SkiTracker to choose client profile photos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "skitracker"
  }
}
